# ─── Application ─────────────────────────────────────────────────────────────
# Absolute origin of this deployment. Invitation links are built from it, and
# the session cookie is marked Secure whenever this is https.
APP_URL=http://localhost:3000

# ─── PostgreSQL (local development values; not secrets) ──────────────────────
POSTGRES_USER=vitalis
POSTGRES_PASSWORD=vitalis
POSTGRES_DB=vitalis_preflight
POSTGRES_PORT=5433

DATABASE_URL=postgres://vitalis:vitalis@localhost:5433/vitalis_preflight

# ─── External integration API (/api/v1/*) ────────────────────────────────────
# Bearer credential for integrators. Leave EMPTY to keep the external API
# closed. Generate one with: openssl rand -base64 48
VITALIS_API_KEY=

# Opens POST /api/v1/guides/validate — and nothing else — without a credential,
# so the validator can be exercised from a form. It reads no stored guide and
# writes none. Refused outright when NODE_ENV=production.
VITALIS_API_DEMO_MODE=false

# ─── Remote MCP endpoint (/mcp) ──────────────────────────────────────────────
# Bearer credential for MCP clients. Leave EMPTY to keep /mcp closed.
# Generate one with: openssl rand -base64 48
VITALIS_MCP_API_KEY=

# ─── Observation interpreter ─────────────────────────────────────────────────
# "heuristic" runs fully offline and is the default.
# "llm" requires ANTHROPIC_API_KEY and falls back to the heuristic on failure.
OBSERVATION_INTERPRETER=heuristic
# ANTHROPIC_API_KEY=
# OBSERVATION_LLM_MODEL=claude-sonnet-5

# ─── First administrator (optional; scripts/bootstrap-admin.mts) ─────────────
# Only read by `pnpm bootstrap:admin`. Prefer leaving these unset and letting
# the script prompt, so the password never reaches shell history.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
